# ==================================================
# OncoVision — Root Git Ignore
# ==================================================

# =========================
# OS
# =========================
.DS_Store
Thumbs.db

# =========================
# IDE / Editors
# =========================
.vscode/
.idea/

# =========================
# Git
# =========================
*.swp
*.swo

# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example

**/.env
**/.env.*
!**/.env.example

# =========================
# Python — Backend
# =========================
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Virtual environments
venv/
.venv/
env/
**/venv/
**/.venv/

# =========================
# Backend Logs
# =========================
**/logs/
*.log

# =========================
# Backend Storage
# =========================
Backend/storage/uploads/
Backend/storage/reports/
Backend/storage/models/

# Also support lowercase backend if folder name changes
backend/storage/uploads/
backend/storage/reports/
backend/storage/models/

# =========================
# Python Coverage
# =========================
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# =========================
# Frontend — Node
# =========================
Frontend/node_modules/
Frontend/dist/

# Also support lowercase frontend
frontend/node_modules/
frontend/dist/

# =========================
# General Node
# =========================
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# =========================
# Frontend Build
# =========================
**/dist/
**/build/

# =========================
# Docker
# =========================
*.docker.env

# =========================
# Temporary Files
# =========================
*.tmp
*.temp
*.bak