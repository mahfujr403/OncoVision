# ==================================================
# OncoVision AI Backend — Environment Configuration
# ==================================================
# Copy this file to `.env` for local development. In production (Render),
# set these as real environment variables instead of shipping a `.env`
# file -- `.dockerignore` excludes `.env*` from the image for this reason.
#
# Variable names below must match app/core/settings.py exactly.

# --- Application metadata ---
APP_NAME=OncoVision AI Backend
APP_VERSION=1.0.0
# development | production
APP_ENV=development
DEBUG=false

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated trusted origins (e.g. "https://oncovision-live.netlify.app").
# In production, "*" is strictly rejected when credentials are enabled.
ALLOWED_ORIGINS=https://oncovision-live.netlify.app

# --- Database ---
# Local/dev default matches docker-compose.yml's `db` service.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oncovision

# --- JWT / authentication ---
# REQUIRED in production: a strong, unique secret. The application refuses
# to start with the insecure development default when APP_ENV=production.
JWT_SECRET_KEY=insecure-development-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# --- AI model storage (Hugging Face Hub) ---
# Required only if the configured models are hosted in a private/gated
# Hugging Face repository.
HF_TOKEN=

# --- Storage paths ---
MODEL_STORAGE_PATH=storage/models
UPLOAD_PATH=storage/uploads
REPORT_PATH=storage/reports

# --- docker-compose only ---
# Used by docker-compose.yml to configure the local `db` service; ignored
# by the application itself (DATABASE_URL above is what it reads).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oncovision

# --- LLM / Gemini API (Phase 11 — LLM + RAG Integration) ---
# REQUIRED: Google AI Studio API key for Gemini models.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_EMBEDDING_MODEL=gemini-embedding-2
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

# --- RAG configuration (Phase 11, Phase 3 & Phase 4) ---
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.55
RAG_MAX_CONTEXT_CHUNKS=5
RAG_CANDIDATE_POOL_SIZE=15
RAG_GENERATION_MODEL=gemini-3.5-flash-lite
RAG_GENERATION_TEMPERATURE=0.2
RAG_GENERATION_MAX_OUTPUT_TOKENS=768
RAG_GENERATION_TIMEOUT=30.0
RAG_GENERATION_MAX_RETRIES=2
RAG_MIN_GROUNDING_SIMILARITY=0.75
RAG_STRONG_GROUNDING_SIMILARITY=0.82
RAG_OBSERVABILITY_ENABLED=true
RAG_LOG_QUERY_CONTENT=false

# --- Chat rate limiting & input boundaries (Phase 6.2-B, FINDING-06) ---
CHAT_RATE_LIMIT_MAX_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=3600
CHAT_MAX_MESSAGE_LENGTH=2000

# --- Authentication rate limiting (Phase 6.1-D, FINDING-05) ---
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REGISTER_RATE_LIMIT_MAX_REQUESTS=3
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Security Headers (Phase 6.1-C) ---
# HSTS is applied automatically in production or over HTTPS.
# HSTS_ENABLED=true
# HSTS_MAX_AGE_SECONDS=31536000
# HSTS_INCLUDE_SUBDOMAINS=true
# HSTS_PRELOAD=false

# --- Knowledge Base & Ingestion (Phase 2) ---
# Project-relative or absolute path to curated medical knowledge base corpus
KNOWLEDGE_BASE_PATH=knowledge_base/oncovision_medical_knowledgebase_v3
# Ingestion must NOT block production startup by default; keep false
AUTO_INGEST_ON_STARTUP=false

