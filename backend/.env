# ==================================================
# OncoVision AI Backend — Environment Configuration
# ==================================================
# Copy this file to `.env` and adjust values as needed.

# Application metadata
APP_NAME=OncoVision AI Backend
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server configuration
HOST=0.0.0.0
PORT=8000

# API configuration
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO

# Upload / storage configuration
MAX_UPLOAD_SIZE=10485760
MODEL_STORAGE_PATH=storage/models
UPLOAD_PATH=storage/uploads
REPORT_PATH=storage/reports

# AI model registry configuration
MODEL_MANIFEST_PATH=app/ml/manifest/models.json

# AI runtime configuration
# Number of enabled models (by ascending priority) loaded eagerly at startup.
# Remaining enabled models are loaded lazily on first request.
STARTUP_MODEL_LOAD_LIMIT=3

# CORS (comma-separated list of origins, or "*" for all)
ALLOWED_ORIGINS=*

# Database configuration
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_3poIZdQwecH1@ep-silent-base-az8vimks-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb

# JWT / authentication configuration
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

